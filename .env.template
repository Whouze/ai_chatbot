# ==========================================
# APPLICATION SETTINGS
# ==========================================
ENV_APP_NAME="AI Chatbot API"
ENV_DEBUG=True
ENV_LOG_LEVEL="INFO"

# ==========================================
# DATABASE SETTINGS (PostgreSQL)
# ==========================================
# Example: postgresql://username:password@localhost:5432/dbname
ENV_DATABASE_URL="postgresql://user:password@localhost:5432/ai_chatbot_db"

# ==========================================
# GEMINI AI SETTINGS
# ==========================================
# Get an API key from: https://aistudio.google.com/app/apikey
ENV_GEMINI_API_KEY="your_google_gemini_api_key_here"
ENV_GEMINI_MODEL="gemini-2.5-flash"

# ==========================================
# JWT AUTHENTICATION SETTINGS
# ==========================================
# Generate a secret key with: python -c "import secrets; print(secrets.token_hex(32))"
ENV_JWT_SECRET_KEY="your_super_secret_jwt_key_here"
ENV_JWT_ALGORITHM="HS256"
ENV_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ==========================================
# PASSWORD HASHING SETTINGS
# ==========================================
ENV_HASHING_STRING="bcrypt"

# ==========================================
# PROMPT & KNOWLEDGE BASE SETTINGS
# ==========================================
ENV_PROMPT_FOLDER="prompt"
ENV_PROMPT_SYSTEM="system_prompt.txt"
ENV_KNOWLEDGE_FOLDER="knowledge"
ENV_KNOWLEDGE_FILE="bobby_knowledge.json"
